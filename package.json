{
  "name": "whatsapp-api-gateway",
  "version": "1.0.0",
  "description": "API gateway for whatsapp-web.js secured with Keycloak, documented with tsoa/Swagger.",
  "main": "dist/server.js",
  "scripts": {
    "tsoa": "tsoa spec-and-routes",
    "spec": "tsoa spec",
    "routes": "tsoa routes",
    "build": "tsoa spec-and-routes && tsc",
    "start": "node dist/server.js",
    "predev": "tsoa spec-and-routes",
    "dev": "nodemon --watch src --ext ts --ignore src/generated --exec \"tsc && node --enable-source-maps dist/server.js\"",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@tsoa/runtime": "^6.6.0",
    "amqplib": "^2.2.0",
    "dotenv": "^18.0.8",
    "elastic-apm-node": "^4.18.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "tsyringe": "^4.10.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "allowScripts": {
    "puppeteer@24.38.0": true
  }
}
