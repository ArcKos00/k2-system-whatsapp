# ── Required ───────────────────────────────────────────────────
# Postgres, directly (not pgbouncer in transaction mode). Tables go to the role's search_path.
DATABASE_URL=postgres://wa_reader:change-me@localhost:5432/whatsapp?sslmode=disable

# ── HTTP ───────────────────────────────────────────────────────
PORT=3000
# Sub-path behind an ingress, e.g. /whatsapp. Empty when served at the root.
PATH_BASE=
# debug | info | warn | error
LOG_LEVEL=info

# ── WhatsApp ───────────────────────────────────────────────────
# Names the session and its owner lock.
WHATSAPP_CLIENT_ID=default
# Minimum delay between outbound messages (ban risk).
WHATSAPP_MESSAGE_DELAY_MS=3000
# WHATSAPP_LOGIN_WAIT_MS=60000
# WHATSAPP_DEVICE_NAME=K2 WhatsApp Gateway
# WHATSAPP_HISTORY_RETENTION_SEC=604800
# IDEMPOTENCY_TTL_MS=604800000
# IDEMPOTENCY_IN_FLIGHT_TIMEOUT_MS=300000

# ── RabbitMQ (inbound messages) ────────────────────────────────
# Unset: events are kept in the outbox and published once a broker is configured.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=whatsapp.messages
# Forward allowlist (GET /chats lists the ids). Empty = every chat.
# RABBITMQ_CHAT_IDS=120363000000000000@g.us,status@broadcast
