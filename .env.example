# ── HTTP server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Sub-path the service is served under behind an ingress (Kubernetes).
# Leave empty when served at the root. Example: /whatsapp-api
PATH_BASE=

# ── Keycloak (token validation) ────────────────────────────────
# Base URL WITHOUT trailing slash and WITHOUT /realms.
KEYCLOAK_AUTH_SERVER_URL=https://keycloak.example.com
KEYCLOAK_REALM=k2-system
# Expected token audience (client id). Leave empty to skip audience check.
# Requires an "Audience" mapper in Keycloak to populate `aud`.
KEYCLOAK_AUDIENCE=whatsapp-api

# ── WhatsApp (whatsapp-web.js) ─────────────────────────────────
# Logical session id (allows multiple numbers under one data path).
WHATSAPP_CLIENT_ID=default
# Persisted LocalAuth session directory — mount as a volume for persistence.
WHATSAPP_SESSION_PATH=/app/data/sessions
# Minimum delay (ms) between outbound messages to reduce ban risk.
WHATSAPP_MESSAGE_DELAY_MS=3000
# Where the login QR PNG is written (defaults to <session path>/qr.png).
# WHATSAPP_QR_PATH=/app/data/qr.png
#
# ── Liveness & no-loss delivery ────────────────────────────────
# Active liveness probe: how often to check the session is still alive and
# recover it if not. Catches "silent" deaths where inbound events just stop.
# WHATSAPP_HEALTH_CHECK_INTERVAL_MS=60000
# WHATSAPP_HEALTH_CHECK_TIMEOUT_MS=15000

# Watchdog: how long the client may stay authenticated-but-not-ready before the
# session is restarted. Guards the case where login succeeds but the 'ready'
# event never arrives, leaving every send failing with WA_NOT_READY. 0 = off.
# WHATSAPP_READY_TIMEOUT_MS=180000
# Reconcile loop: re-scans chats for messages newer than the delivery cursor and
# (re)publishes any RabbitMQ hasn't confirmed. This is the safety net that makes
# inbound delivery lossless across session downtime and broker outages. 0 = off.
# WHATSAPP_RECONCILE_INTERVAL_MS=30000
# Max messages fetched per chat during a catch-up/reconcile scan.
# WHATSAPP_CATCHUP_LIMIT_PER_CHAT=50
# How many reconcile passes may fail in a row before the session is restarted.
# One-off failures are normal (WhatsApp Web throws out of getChats when a single
# chat won't serialize); a persistent one means the injected page state is
# broken, which getState() does not detect. 0 = never escalate.
# WHATSAPP_RECONCILE_MAX_FAILURES=3
# Seconds of overlap re-scanned below the cursor (guards against late-syncing
# messages with an older timestamp; duplicates are deduped downstream by id).
# WHATSAPP_RECONCILE_LOOKBACK_SEC=0
# Where the delivery cursor is persisted (defaults to <session path>/cursor.json).
# Keep it on the same durable volume as the session.
# WHATSAPP_CURSOR_PATH=/app/data/sessions/cursor.json

# ── Puppeteer / Chromium ───────────────────────────────────────
# Browser resolution priority: PUPPETEER_EXECUTABLE_PATH > PUPPETEER_BROWSER_CHANNEL > bundled.
#
# In Docker: point at the system Chromium installed by the Dockerfile.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_DOWNLOAD=true
#
# For LOCAL dev (Windows/macOS) leave PUPPETEER_EXECUTABLE_PATH unset and instead
# launch an already-installed browser channel — no Chromium download needed:
# PUPPETEER_BROWSER_CHANNEL=chrome

# ── RabbitMQ (forward inbound WhatsApp messages) ───────────────
# Inbound messages are published to a `headers`-type exchange, each tagged
# with a `chatId` header so consumers can bind a queue that matches a chat.
# Leave RABBITMQ_URL empty to disable forwarding.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Headers exchange name (created on startup, durable).
RABBITMQ_EXCHANGE=whatsapp.messages
# Comma-separated allowlist of chat ids (message.from) to forward. Each inbound
# message is tagged with a `chatId` header. Leave empty to forward ALL chats.
# RABBITMQ_CHAT_IDS=380501234567@c.us,120363000000000000@g.us
# Pause (ms) before retrying a lost AMQP connection.
# RABBITMQ_RECONNECT_DELAY_MS=5000

# ── Elastic APM (observability) ────────────────────────────────
# The agent only starts when a server URL is set (or ELASTIC_APM_ACTIVE=true),
# so leaving these unset disables APM for local runs. When orchestrated by the
# Aspire AppHost these are injected automatically.
# ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_SERVICE_NAME=whatsapp-api
ELASTIC_APM_ENVIRONMENT=development
# ELASTIC_APM_SECRET_TOKEN=
# ELASTIC_APM_ACTIVE=true
